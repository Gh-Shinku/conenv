{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conenv.dev/schema/conenv.v2.schema.json",
  "title": "conenv manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles", "components"],
  "properties": {
    "schemaVersion": { "const": "conenv/v2" },
    "defaultProfile": { "type": "string" },
    "variables": { "$ref": "#/$defs/stringMap" },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "env": { "type": "string" },
          "file": { "type": "string" }
        },
        "oneOf": [
          { "required": ["env"] },
          { "required": ["file"] }
        ]
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extends": { "$ref": "#/$defs/stringArray" },
        "components": { "$ref": "#/$defs/stringArray" },
        "variables": { "$ref": "#/$defs/stringMap" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": { "enum": ["program", "ai"] },
        "description": { "type": "string" },
        "platforms": { "$ref": "#/$defs/stringArray" },
        "architectures": { "$ref": "#/$defs/stringArray" },
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/package" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/file" }
        },
        "agents": {
          "type": "object",
          "description": "Harness targets this component contributes to, keyed by agent name.",
          "additionalProperties": { "$ref": "#/$defs/agent" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness"],
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "description": "Registered harness adapter, for example codex, pi, or global."
        },
        "configPath": {
          "type": "string",
          "description": "Optional override; defaults to the harness global configuration file."
        },
        "skillsDir": {
          "type": "string",
          "description": "Optional override; defaults to the shared global skills directory."
        },
        "config": {
          "type": "object",
          "description": "Settings merged into the harness configuration file. Only keys the adapter manages are accepted."
        },
        "mcpServers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/mcp" }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "id"],
      "properties": {
        "name": { "type": "string" },
        "manager": { "enum": ["winget", "scoop"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "mode"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["link", "render"] },
        "sensitive": { "type": "boolean" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["http", "stdio"] },
        "url": { "type": "string" },
        "command": { "type": "string" },
        "args": { "$ref": "#/$defs/stringArray" },
        "env": { "$ref": "#/$defs/stringMap" },
        "enabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "http" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "type": { "const": "stdio" } } },
          "then": { "required": ["command"] }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["path", "command"] },
        "path": { "type": "string" },
        "command": { "type": "string" },
        "args": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
